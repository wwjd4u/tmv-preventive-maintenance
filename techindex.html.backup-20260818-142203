<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>TMV Field Work Orders</title>
<style>
  :root{--cudd:#812F2F;--ink:#1a1a1a;--line:#e3e3e3;--ok:#16a34a;--warn:#d97706}
  *{box-sizing:border-box}
  body{margin:0;font:15px/1.4 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:#f5f6f8;color:var(--ink)}
  header{background:var(--cudd);color:#fff;padding:14px 16px;position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:10px}
  header h1{font-size:17px;margin:0;font-weight:600}
  main{padding:14px;max-width:560px;margin:0 auto;padding-bottom:30px}
  .hint{color:#666;font-size:13px;margin:4px 2px 14px}
  .filters{display:flex;gap:8px;margin:0 2px 14px}
  .filters select{flex:1;min-width:0;font:14px inherit;padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:#fff}
  .card{border:1px solid var(--line);border-radius:12px;background:#fff;padding:14px;margin-bottom:12px;display:block;text-decoration:none;color:inherit}
  .card:active{background:#fafafa}
  .card .t{font-weight:700;font-size:16px}
  .card .sub{color:#666;font-size:13px;margin-top:3px}
  .card .tech{color:var(--cudd);font-size:13px;margin-top:6px;font-weight:600}
  .card .ct{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
  .card .ct a{display:inline-flex;align-items:center;gap:5px;padding:6px 11px;border-radius:999px;color:#fff;text-decoration:none;font-size:12px;font-weight:600}
  .card .ct .c-call{background:#16a34a}
  .card .ct .c-mail{background:#812F2F}
  .card .ct .c-sms{background:#2563eb}
  .badge{display:inline-block;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:600;color:#fff;background:#6b7280;margin-top:8px}
  .badge.assigned{background:#6b7280}.badge.in_progress{background:var(--warn)}.badge.completed{background:var(--ok)}
  .empty{text-align:center;color:#888;padding:40px 10px}
  .app-footer{text-align:center;color:#9aa;font-size:12px;padding:18px;margin-top:8px}
  .app-footer a{color:#9aa;text-decoration:none}
  .app-footer a:hover{text-decoration:underline}
</style>
</head>
<body>
<header><h1>TMV Field Work Orders</h1></header>
<main>
  <div class="hint">Open a work order to complete the checklist with photos. Tap a card to begin.</div>
  <div class="filters">
    <select id="filterTech"><option value="all">All technicians</option></select>
    <select id="filterTmv"><option value="all">All TMVs</option></select>
  </div>
  <div id="list"><div class="empty">Loading…</div></div>
</main>
<footer class="app-footer">
  <a href="security.html">Security</a> · <a href="terms.html">Terms &amp; Conditions</a><br>
  CUDD Energy Services · Preventive Maintenance
</footer>
<script>
function esc(s){return (s==null?'':String(s)).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
var ALL=[];
function techName(a){ var t=a.technician; return (typeof t==='string') ? t : ((t&&t.name)||''); }
function uniqueTechs(){ var s={}; ALL.forEach(function(a){ var n=techName(a); if(n) s[n]=1; }); return Object.keys(s).sort(); }
function uniqueTmvs(){ var s={}; ALL.forEach(function(a){ if(a.tmv) s[a.tmv]=1; }); return Object.keys(s).sort(); }
function populateFilters(){
  var ft=document.getElementById('filterTech');
  ft.innerHTML='<option value="all">All technicians</option>'+uniqueTechs().map(function(n){return '<option value="'+esc(n)+'">'+esc(n)+'</option>';}).join('');
  var fv=document.getElementById('filterTmv');
  fv.innerHTML='<option value="all">All TMVs</option>'+uniqueTmvs().map(function(t){return '<option value="'+esc(t)+'">'+esc(t)+'</option>';}).join('');
}
function cardHtml(a){
  var t=a.technician; if(typeof t==='string') t={name:t};
  var phone=(t.phone||'').trim(); var email=(t.email||'').trim(); var sms=phone.replace(/\D/g,'');
  var links=[];
  if(phone) links.push('<a class="ct-call" href="tel:'+encodeURIComponent(phone)+'"><span class="ci">📞</span>Call</a>');
  if(email) links.push('<a class="ct-mail" href="mailto:'+encodeURIComponent(email)+'?subject='+encodeURIComponent('Work Order — '+a.tmv)+'&body='+encodeURIComponent('Open your task: '+location.origin+'/tech/'+a.id)+'"><span class="ci">✉️</span>Email</a>');
  if(sms) links.push('<a class="ct-sms" href="sms:'+encodeURIComponent(sms)+'?&body='+encodeURIComponent('CUDD work order: '+location.origin+'/tech/'+a.id)+'"><span class="ci">💬</span>Text</a>');
  return '<a class="card" href="/tech/'+encodeURIComponent(a.id)+'">'
    +'<div class="t">'+esc(a.tmv)+'</div>'
    +'<div class="sub">'+esc(a.vanType||'')+(a.location?(' · '+esc(a.location)):'')+' · '+esc(a.date)+'</div>'
    +'<div class="tech">Tech: '+esc(techName(a))+'</div>'
    +(links.length?'<div class="ct">'+links.join('')+'</div>':'')
    +'<span class="badge '+a.status+'">'+(a.status||'assigned').replace('_',' ')+'</span>'
    +'</a>';
}
function render(){
  var ft=document.getElementById('filterTech').value;
  var fv=document.getElementById('filterTmv').value;
  var list=ALL.filter(function(a){
    if(ft!=='all' && techName(a)!==ft) return false;
    if(fv!=='all' && a.tmv!==fv) return false;
    return true;
  });
  var el=document.getElementById('list');
  if(!list.length){ el.innerHTML='<div class="empty">No work orders match the filters.</div>'; return; }
  el.innerHTML=list.map(cardHtml).join('');
}
async function load(){
  try{
    var r=await fetch('/api/assignments'); var d=await r.json();
    ALL=(d.assignments||[]).filter(function(a){return a.status!=='completed';});
    populateFilters();
    render();
  }catch(e){ document.getElementById('list').innerHTML='<div class="empty">Could not load: '+esc(e.message)+'</div>'; }
}
['filterTech','filterTmv'].forEach(function(id){ var e=document.getElementById(id); if(e) e.addEventListener('change', render); });
load();
</script>
</body>
</html>
