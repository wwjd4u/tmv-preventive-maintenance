# TMV Preventive Maintenance — environment variable template
# DO NOT put live credentials in this file.

PORT=9240
HOST=0.0.0.0
AUTH_IDLE_MINUTES=15
TMV_DB_PATH=/home/data/tmv-pm/tmv.db
APP_PUBLIC_URL=https://YOUR-AZURE-HOSTNAME

# Recovery Superuser
ADMIN_USER=
ADMIN_PASS=

# Phone mapping
TECH_PHONES=

# SMS
SMS_PROVIDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TEXTBELT_KEY=
CARRIER_DOMAIN=

# Email
SENDGRID_API_KEY=
SENDGRID_FROM=

# DevIoT
DEVIOT_AUTHORITY=
DEVIOT_CLIENT_ID=
DEVIOT_CLIENT_SECRET=
